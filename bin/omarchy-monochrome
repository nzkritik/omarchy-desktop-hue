#!/usr/bin/env bash
# omarchy-monochrome - duotone/monochrome screen shader for the whole desktop.
#
# Applies a Hyprland screen shader (decoration:screen_shader), which runs on the
# final composited frame. Every window is affected: browsers, video, games,
# the Omarchy bar, notifications, menus. No per-app configuration needed.

set -euo pipefail

SHADER_DIR="$HOME/.config/hypr/shaders/monochrome"
CURRENT="$HOME/.config/hypr/shaders/current.frag"

# name|label|shadow|mid|highlight|gamma|contrast
#   gamma    <1 lifts midtones (brighter), >1 crushes them (darker)
#   contrast 1.0 is neutral; >1 pushes blacks/whites apart
PALETTES=(
  "bw|Black & white (neutral greyscale)|#000000|#7f7f7f|#ffffff|1.00|1.00"
  "ink|Black & white (high contrast)|#000000|#6e6e6e|#ffffff|0.80|1.60"
  "red-black|Red on black|#000000|#6b0f0f|#ff3b30|0.85|1.10"
  "orange-grey|Dark orange on dark grey|#0d0d0d|#3d3a37|#d2691e|0.85|1.05"
  "green-black|Light green on black|#000000|#2f6b3a|#9cff9c|0.85|1.10"
  "teal-black|Teal on black|#000000|#0b5c5c|#2fdede|0.85|1.10"
  "amber-black|Amber CRT on black|#000000|#6b4300|#ffb000|0.85|1.15"
  "blue-black|Ice blue on black|#000000|#10406b|#4fc3f7|0.85|1.10"
  "purple-black|Violet on black|#000000|#3d1a5c|#c77dff|0.85|1.10"
  "sepia|Sepia (warm paper)|#1a120b|#6b4f34|#f0e0c0|0.88|1.00"
)

die() { echo "omarchy-monochrome: $*" >&2; exit 1; }

palette_field() { # <name> <field-index>
  local name="$1" idx="$2" row
  for row in "${PALETTES[@]}"; do
    [[ "${row%%|*}" == "$name" ]] || continue
    IFS='|' read -r -a f <<<"$row"
    printf '%s' "${f[$idx]}"
    return 0
  done
  return 1
}

palette_names() {
  local row
  for row in "${PALETTES[@]}"; do printf '%s\n' "${row%%|*}"; done
}

hex_to_vec3() { # #rrggbb -> "r, g, b" floats
  local h="${1#\#}"
  printf '%.6f, %.6f, %.6f' \
    "$(echo "scale=6; $((16#${h:0:2})) / 255" | bc)" \
    "$(echo "scale=6; $((16#${h:2:2})) / 255" | bc)" \
    "$(echo "scale=6; $((16#${h:4:2})) / 255" | bc)"
}

generate() { # <name> <strength> -> writes .frag, echoes path
  local name="$1" strength="$2"
  local shadow mid high gamma contrast out
  shadow="$(palette_field "$name" 2)" || die "unknown palette '$name'"
  mid="$(palette_field "$name" 3)"
  high="$(palette_field "$name" 4)"
  gamma="$(palette_field "$name" 5)"
  contrast="$(palette_field "$name" 6)"

  mkdir -p "$SHADER_DIR"
  out="$SHADER_DIR/$name.frag"

  cat > "$out" <<EOF
#version 300 es
// Generated by omarchy-monochrome. Regenerated on every 'set' - edit the
// palette table in ~/.local/bin/omarchy-monochrome instead of this file.
//
// Palette: $(palette_field "$name" 1)
precision highp float;

in vec2 v_texcoord;
uniform sampler2D tex;
layout(location = 0) out vec4 fragColor;

const vec3  C_SHADOW = vec3($(hex_to_vec3 "$shadow"));
const vec3  C_MID    = vec3($(hex_to_vec3 "$mid"));
const vec3  C_HIGH   = vec3($(hex_to_vec3 "$high"));
const float GAMMA    = $gamma;
const float CONTRAST = $contrast;
const float STRENGTH = $strength;

vec3 srgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

void main() {
    vec4 px = texture(tex, v_texcoord);

    // Work on straight (un-premultiplied) colour so the tint math is correct.
    vec3 straight = clamp(px.a > 0.0001 ? px.rgb / px.a : px.rgb, 0.0, 1.0);

    // Luminance must be measured in linear light to weight the channels
    // correctly, then re-encoded to perceptual lightness for the ramp index.
    float lum = dot(srgbToLinear(straight), vec3(0.2126, 0.7152, 0.0722));
    float t = pow(clamp(lum, 0.0, 1.0), 1.0 / 2.2);

    t = pow(t, GAMMA);
    t = clamp((t - 0.5) * CONTRAST + 0.5, 0.0, 1.0);

    // The ramp is blended in gamma space, so a black -> mid-grey -> white
    // palette reproduces the original luminance exactly instead of lifting it.
    vec3 toned = t < 0.5
        ? mix(C_SHADOW, C_MID, t * 2.0)
        : mix(C_MID, C_HIGH, (t - 0.5) * 2.0);

    vec3 result = mix(straight, toned, STRENGTH);
    fragColor = vec4(result * px.a, px.a);
}
EOF
  printf '%s' "$out"
}

apply_shader() { # <path-or-empty>
  local value="${1:-[[EMPTY]]}"
  hyprctl eval "hl.config({ decoration = { screen_shader = \"$value\" } })" >/dev/null
}

current_name() {
  [[ -L "$CURRENT" ]] || return 1
  local target; target="$(readlink -f "$CURRENT")" || return 1
  [[ -f "$target" ]] || return 1
  basename "$target" .frag
}

cmd_list() {
  local active row name; active="$(current_name || true)"
  printf '%-14s %-34s %s\n' NAME DESCRIPTION ''
  for row in "${PALETTES[@]}"; do
    IFS='|' read -r -a f <<<"$row"
    name="${f[0]}"
    printf '%-14s %-34s %s\n' "$name" "${f[1]}" \
      "$([[ "$name" == "$active" ]] && echo '  <- active' || true)"
  done
}

cmd_set() {
  local name="${1:-}" strength="${2:-1.0}" path
  [[ -n "$name" ]] || die "usage: omarchy-monochrome set <palette> [strength 0.0-1.0]"
  palette_field "$name" 0 >/dev/null || die "unknown palette '$name' (try: omarchy-monochrome list)"
  path="$(generate "$name" "$strength")"
  ln -sfn "$path" "$CURRENT"
  apply_shader "$CURRENT"
  echo "Monochrome: $(palette_field "$name" 1)"
}

cmd_off() {
  rm -f "$CURRENT"
  apply_shader ""
  echo "Monochrome: off"
}

cmd_toggle() {
  if current_name >/dev/null 2>&1; then cmd_off; else cmd_set "${1:-bw}"; fi
}

notify() { # <summary>
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Monochrome" -t 1500 -h string:x-canonical-private-synchronous:monochrome \
    "Desktop hue" "$1" 2>/dev/null || true
}

# Cycles palette -> palette -> ... -> off -> palette, so the keybinding can
# always get back to full colour without a second command.
cmd_next() {
  local active names i n; active="$(current_name || true)"
  mapfile -t names < <(palette_names)
  n=${#names[@]}

  if [[ -z "$active" ]]; then
    cmd_set "${names[0]}" >/dev/null
    notify "$(palette_field "${names[0]}" 1)"
    echo "Monochrome: $(palette_field "${names[0]}" 1)"
    return
  fi

  for ((i = 0; i < n; i++)); do
    [[ "${names[$i]}" == "$active" ]] || continue
    if (( i + 1 >= n )); then
      cmd_off >/dev/null
      notify "Off (full colour)"
      echo "Monochrome: off"
    else
      cmd_set "${names[$((i + 1))]}" >/dev/null
      notify "$(palette_field "${names[$((i + 1))]}" 1)"
      echo "Monochrome: $(palette_field "${names[$((i + 1))]}" 1)"
    fi
    return
  done

  cmd_set "${names[0]}" >/dev/null
  notify "$(palette_field "${names[0]}" 1)"
  echo "Monochrome: $(palette_field "${names[0]}" 1)"
}

# Machine-readable palette table + active state, for the bar plugin (and any
# other caller that wants the colours rather than the human table). Keeping
# this here means the PALETTES array above stays the single source of truth.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cmd_json() {
  local active row first=1
  active="$(current_name || true)"
  printf '{"active":"%s","palettes":[' "$(json_escape "$active")"
  for row in "${PALETTES[@]}"; do
    IFS='|' read -r -a f <<<"$row"
    (( first )) || printf ','
    first=0
    printf '{"name":"%s","label":"%s","shadow":"%s","mid":"%s","highlight":"%s"}' \
      "$(json_escape "${f[0]}")" "$(json_escape "${f[1]}")" \
      "$(json_escape "${f[2]}")" "$(json_escape "${f[3]}")" "$(json_escape "${f[4]}")"
  done
  printf ']}\n'
}

cmd_status() {
  local active; active="$(current_name || true)"
  if [[ -n "$active" ]]; then
    echo "active: $active - $(palette_field "$active" 1)"
  else
    echo "active: none"
  fi
  echo "hyprland: $(hyprctl getoption decoration:screen_shader | head -1)"
}

case "${1:-status}" in
  list)    cmd_list ;;
  json)    cmd_json ;;
  set)     shift; cmd_set "$@" ;;
  off)     cmd_off ;;
  toggle)  shift; cmd_toggle "$@" ;;
  next)    cmd_next ;;
  status)  cmd_status ;;
  -h|--help|help)
    cat <<'EOF'
omarchy-monochrome - tint the entire desktop with a duotone screen shader

Usage:
  omarchy-monochrome list                       Show available palettes
  omarchy-monochrome set <palette> [strength]   Apply a palette (strength 0.0-1.0, default 1.0)
  omarchy-monochrome next                       Cycle to the next palette (then off, then round again)
  omarchy-monochrome toggle [palette]           Turn on (default bw) / off
  omarchy-monochrome off                        Remove the shader
  omarchy-monochrome status                     Show what is active
  omarchy-monochrome json                       Palette table + active state as JSON

The shader runs on the final composited frame, so it affects every window -
browsers, video, games, the bar - with no per-app configuration.
EOF
    ;;
  *) die "unknown command '$1' (see --help)" ;;
esac
